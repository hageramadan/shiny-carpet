NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_API_BASE_URL=https://admin.shinycarpet-sa.com/api

# Contact details and social links are loaded from GET /settings.
# Optional Photon-compatible geocoding server. Searches run only on user action.
GEOCODING_BASE_URL=https://photon.komoot.io

# Server-only SMS credentials. Never prefix these with NEXT_PUBLIC_.
MORA_SMS_API_KEY=
MORA_SMS_USERNAME=ShinyCarpet
MORA_SMS_SENDER=ShinyCarpet
# Legacy backend verification code, sent only after the server validates the SMS OTP.
BACKEND_AUTH_VERIFY_CODE=
# SQLite must be on persistent storage shared by this app's Node.js workers.
# For multiple application hosts, replace this store with a shared database.
AUTH_OTP_DB_PATH=.data/auth-otp.sqlite
